# App environment. "development" (default) shows demo/mock data, the
# system-store picker, and quick-login shortcuts. "production" starts with
# an empty workspace, seeds a single default admin, and auto-configures the
# system store from NEXT_PUBLIC_DEFAULT_DB_DRIVER below.
NEXT_PUBLIC_APP_ENV=development

# Which backend actually holds the system store (users, roles, audit log):
#   "browser"  (default) — everything lives in the browser's IndexedDB, and
#               login is a client-side password comparison. No real server
#               identity. Fine for a local demo, not for a real deployment.
#   "postgres" — the system store is the real Postgres database provisioned
#               by scripts/init-db.ts (schema "datalook"). Auth is verified
#               server-side against a hashed password with a signed session
#               cookie. Requires PGHOST/PGPORT/PGUSER/PGPASSWORD/
#               SYSTEM_DB_NAME and SESSION_SECRET below to be set — see
#               docker/docker-compose.yaml for a working example.
NEXT_PUBLIC_SYSTEM_BACKEND=browser

# Driver used to initialize the system store on first run when
# NEXT_PUBLIC_APP_ENV=production. One of: postgres, mysql, sqlite,
# clickhouse, cockroach, mongodb, couchdb, redis, cassandra, dynamodb
# (mssql is not yet supported — see lib/db/adapter-factory.ts).
# When NEXT_PUBLIC_SYSTEM_BACKEND=postgres this must be "postgres".
NEXT_PUBLIC_DEFAULT_DB_DRIVER=postgres

# Default admin account seeded on first run in production.
NEXT_PUBLIC_DEFAULT_ADMIN_NAME=Admin
NEXT_PUBLIC_DEFAULT_ADMIN_EMAIL=admin@yourcompany.com

# Login password used when NEXT_PUBLIC_SYSTEM_BACKEND=browser (the demo/
# IndexedDB path — no real backend, see components/providers/auth-provider.tsx).
# Ignored when NEXT_PUBLIC_SYSTEM_BACKEND=postgres: the real admin password is
# whatever ADMIN_PASSWORD was set to when scripts/init-db.ts created the
# admin user (it's hashed and stored in Postgres, not read from here).
NEXT_PUBLIC_DEFAULT_ADMIN_PASSWORD=datalook

# Optional: base64-encoded 256-bit AES key for encrypting connection credentials
# at rest. Generate one with: openssl rand -base64 32
# If omitted, a key is auto-generated and stored in the browser's IndexedDB.
# NEXT_PUBLIC_AES_KEY=

# Name of the system database created on first run in production.
NEXT_PUBLIC_SYSTEM_DB_NAME=datalook-studio

# Default database connection credentials for the system store.
# When set, the system store connection uses these instead of placeholder values.
# NEXT_PUBLIC_DEFAULT_DB_HOST=localhost
# NEXT_PUBLIC_DEFAULT_DB_PORT=5432
# NEXT_PUBLIC_DEFAULT_DB_USER=system
# NEXT_PUBLIC_DEFAULT_DB_PASSWORD=
# NEXT_PUBLIC_DEFAULT_DB_NAME=datalook-studio

# When "true", the app seeds the admin from the env vars above and skips
# the interactive onboarding flow. When unset/false, production deployments
# show an onboarding screen where the user sets up the admin account and
# system store themselves.
NEXT_PUBLIC_SKIP_ONBOARDING=true

# --- Server-only secrets (never prefixed NEXT_PUBLIC_ — not sent to the browser) ---

# Postgres connection used by scripts/init-db.ts AND, when
# NEXT_PUBLIC_SYSTEM_BACKEND=postgres, by the running app itself to read and
# write the real system store. Required for a real (non-demo) deployment.
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=postgres
# SYSTEM_DB_NAME=datalook-studio

# Admin user created by scripts/init-db.ts the first time it runs. Not used
# after that — change the password from within the app once signed in.
# ADMIN_NAME=Admin
# ADMIN_EMAIL=admin@datalook.com
# ADMIN_PASSWORD=Datalook@123

# Secret used to sign session cookies when NEXT_PUBLIC_SYSTEM_BACKEND=postgres.
# Generate one with: openssl rand -base64 32
# Falls back to CONN_ENCRYPTION_KEY, then to an insecure built-in default (a
# warning is logged) — set this explicitly for any real deployment, since
# anyone who knows the fallback secret could forge a session cookie.
# SESSION_SECRET=

# 32-byte hex or base64 key (or any string, which gets hashed to 32 bytes)
# used to encrypt connection credentials at rest on the server filesystem
# (lib/db/server-crypto.ts). Falls back to a hashed default if unset — set
# this explicitly for any real deployment.
# CONN_ENCRYPTION_KEY=
